{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@uikit-docs/*": [
        "./node_modules/@tugen/uikit/docs/src/*"
      ],
      "@uikit-gallery/*": [
        "./node_modules/@tugen/uikit/example/src/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
